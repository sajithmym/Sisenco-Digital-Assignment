# ─── Server ─────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection (used by db-init to create the database)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=weekly_report_db

# Full connection string — REQUIRED by Prisma (migrations + client).
# Prisma expands the values defined above, so connection details have one source of truth.
# URL-encode DB_PASSWORD first if it includes characters such as @, :, /, or #.
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ─── JWT / Auth ─────────────────────────────────────────────
# Generate strong secrets:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#                           openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Browser session security. For separate production frontend/API domains, keep
# AUTH_COOKIE_SAME_SITE=none and serve both applications over HTTPS.
AUTH_COOKIE_SAME_SITE=lax
# Internal systems should set this to false and create users through an admin or SSO.
ALLOW_SELF_REGISTRATION=true
