# Copy this file to .env for local development.
# Replace database credentials and JWT placeholders for deployment.

# ─── Server ─────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:3000
# Public API address used in startup logs (optional; defaults to http://localhost:PORT).
PUBLIC_API_URL=http://localhost:5000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection (used by db-init to create the database)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=weekly_report_db

# Full connection string — REQUIRED by Prisma (migrations + client).
# Prisma expands the values defined above, so connection details have one source of truth.
# Keep DB_* values unencoded; quote values containing # or spaces.
# For credentials with URL-reserved characters, replace DATABASE_URL with a full
# literal URL with encoded credentials, so Prisma and the backend use the same URL.
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ─── JWT / Auth ─────────────────────────────────────────────
# Generate strong secrets:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#                           openssl rand -hex 32
# Production requires two distinct secrets, each at least 32 characters long.
JWT_ACCESS_SECRET=change-me-to-a-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Accepted values: lax, strict, none. Defaults to lax in development, none in production.
# Browser session security. For separate production frontend/API sites, set
# AUTH_COOKIE_SAME_SITE=none and serve both applications over HTTPS.
AUTH_COOKIE_SAME_SITE=lax
# When true, self-registered accounts are saved pending administrator activation.
# Set this to false to disable public registration.
# If omitted, defaults to true in development and false in production.
ALLOW_SELF_REGISTRATION=true
