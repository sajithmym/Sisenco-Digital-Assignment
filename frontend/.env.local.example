# Copy this file to .env.local for local development.
# NEXT_PUBLIC_* values are public browser configuration; never put secrets here.
# NODE_ENV is managed by the Next.js dev/build/start commands.

# ─── API ────────────────────────────────────────────────────
# URL of the backend API (must match the backend PORT + apiPrefix "api/v1")
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# ─── Application ────────────────────────────────────────────
# IANA timezone used for application dates (defaults to Asia/Colombo).
NEXT_PUBLIC_APP_TIMEZONE=Asia/Colombo
